# Copie este archivo como .env (nunca suba .env a Git).

# Modelo local con Ollama (por defecto). Con LM Studio: LOCAL_URL=http://localhost:1234/v1
BACKEND=local
LOCAL_URL=http://localhost:11434/v1
LOCAL_MODELO=qwen3:4b-instruct

# Groq en la nube (plan gratuito). Los datos SALEN del equipo: solo con datos sintéticos.
# GROQ_API_KEY=gsk_...
# GROQ_MODELO=openai/gpt-oss-20b

# Base de datos: sqlite (archivo local, por defecto) o sqlserver (la base compartida del curso).
DB_MOTOR=sqlite
# DB_MOTOR=sqlserver
# SQLSERVER_HOST=aurora-obs-francecentral.database.windows.net
# SQLSERVER_DB=aurora
# SQLSERVER_USER=estudiante
# SQLSERVER_PASSWORD=<la clave que comparte el docente>

# MLflow: sin esto, todo queda en mlflow.db junto al código.
# MLFLOW_TRACKING_URI=http://127.0.0.1:5070
